              "id": "7b328292-6bf8-4081-a762-9b8aa801f812",
              "name": "mail_content",
              "value": "={{ (() => {\n  const m = $('Merge').item.json;\n  let c = m.text || '';\n  if (typeof m.html === 'string') {\n    const h = m.html\n      .replace(/<!--[\\s\\S]*?-->/g, ' ')\n      .replace(/<(style|script|head)[\\s\\S]*?<\\/\\1>/gi, ' ')\n      .replace(/<br\\s*\\/?>|<\\/(p|div|tr|li|h[1-6])>/gi, '\\n')\n      .replace(/<[^>]+>/g, ' ')\n      .replace(/&nbsp;/gi, ' ').replace(/&amp;/gi, '&')\n      .replace(/&#39;|&apos;/gi, \"'\").replace(/&quot;/gi, '\"')\n      .replace(/&[a-z0-9#]+;/gi, ' ');\n    if (h.trim().length > c.trim().length * 1.5) c = h;\n  }\n  c = c.replace(/\\b(?:https?:\\/\\/|www\\.)[^\\s<>\"']+/gi, '[link]')\n       .replace(/[\\u00AD\\u034F\\u180E\\u200B-\\u200F\\u2060-\\u2064\\uFEFF]/g, '')\n       .replace(/[ \\t]+/g, ' ')\n       .replace(/\\n\\s*\\n+/g, '\\n\\n')\n       .trim();\n  return c || \"[Mail sans contenu texte — classer sur l'objet et l'expéditeur]\";\n})() }}",
              "type": "string"
            },
