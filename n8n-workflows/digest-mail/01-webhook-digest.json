    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Mise en forme seulement : les règles (sections, durées, ordre) sont dans les nœuds précédents.\nconst sections = [];\nfor (const { json: m } of $input.all()) {\n  const { section, ...mail } = m;\n  if (!section?.cle) continue; // item vide quand aucun mail n'est à afficher\n  let s = sections.find(x => x.cle === section.cle);\n  if (!s) sections.push(s = { cle: section.cle, libelle: section.libelle, resume: section.resume, items: [] });\n  s.items.push(mail);\n}\nconst resume = sections\n  .map(s => ({ n: s.items.filter(m => !m.lu).length, texte: s.resume }))\n  .filter(x => x.n > 0)\n  .map(x => `${x.n} ${x.texte}`)\n  .join(' · ');\nreturn [{ json: { resume: resume || 'rien de neuf', sections: sections.map(({ resume, ...s }) => s) } }];"
      },
