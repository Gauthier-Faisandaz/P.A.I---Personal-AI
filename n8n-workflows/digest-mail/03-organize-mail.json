        "jsCode": "// Le LLM constate des faits (action, domaine, échéance) ; le code décide de la catégorie.\nconst o = $json.output || {};\nconst today = DateTime.now().setZone('Europe/Paris').startOf('day');\n\nlet echeance = null;\nlet days_left = null;\nif (o.echeance) {\n  const d = DateTime.fromISO(o.echeance, { zone: 'Europe/Paris' });\n  if (d.isValid) {\n    echeance = d.toISODate();\n    days_left = Math.round(d.startOf('day').diff(today, 'days').days);\n  }\n}\n\n// Domaines pour lesquels un mail « à lire » mérite d'être montré\nconst IMPORTANT = ['emploi_formation', 'admin_finance', 'pro', 'recherche_reseau', 'perso'];\n\nlet category = 'a_traiter'; // filet de sécurité si la sortie est incomplète\nif (o.domaine === 'promo') category = 'ignorer';\nelse if (o.action === 'repondre' || o.action === 'agir') category = (days_left !== null && days_left <= 2) ? 'urgent' : 'a_traiter';\nelse if (o.action === 'attendre') category = 'en_attente';\nelse if (o.action === 'lire') category = IMPORTANT.includes(o.domaine) ? 'a_lire' : 'ignorer';\nelse if (o.action === 'rien') category = 'ignorer';\n\nreturn { json: {\n  mail_id: $('Loop Over Items').item.json.mail_id,\n  category,\n  action: o.action ?? null,\n  domaine: o.domaine ?? null,\n  echeance,\n  days_left,\n  reason: o.raison ?? ''\n} };"
      },
