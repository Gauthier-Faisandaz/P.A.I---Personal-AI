;; ~/.config/eww/eww.yuck - Viridis Lab : colonne (recommandations, a venir,
;;                          boite de reception, veille) + bandeau (verre)
;; Demarrage :  voir start.sh (ouvre toutes les fenetres sur le bon ecran)
;; Recharger :  eww reload
;;
;; NOTE (12/08) : le survol (apercu au hover) a ete entierement retire.
;; Il causait des bugs recurrents et jamais totalement resolus (fenetres qui
;; restent ouvertes, qui ne s'affichent pas, fond glassmorphique fantome
;; visible en permanence...) malgre plusieurs refontes successives.
;;
;; NOTE (11/09, etape 0 de la colonne elastique) : l'accordeon (un seul
;; panneau deplie a la fois) et le detail mail affiche a la place de la
;; liste ont ete retires : ils forcaient a cliquer pour voir ce que le
;; dashboard doit montrer d'un coup d'oeil. Les panneaux sont desormais
;; toujours visibles. Version accordeon : branche refonte-colonne.
;;
;; NOTE (repli des panneaux) : un clic sur l'en-tete d'un panneau le REPLIE
;; (il ne garde que son en-tete et son compteur) pour donner sa place aux
;; autres ; nouveau clic, il se rouvre. Ce n'est PAS l'accordeon : le
;; defaut reste "tout ouvert", plusieurs panneaux (ou tous) peuvent etre
;; replies, et rien n'oblige a cliquer pour lire.
;;
;; Noms a ne pas renommer sans mettre a jour les scripts :
;;   - variables digest recos venir veille  -> sync.sh
;;   - variables h_* y_* t_* r_* seuil_corps -> mise-en-page.py
;;   - variables mail_modale veille_modale  -> ui.sh, mise-en-page.py
;;   - variables y_mail y_veille            -> ui.sh
;;   - fenetre colonne                      -> ouvrir-colonne.sh
;;   - fenetre modale                       -> ui.sh, ouvrir-colonne.sh


;; ==========================================================================
;;  WIDGETS COMMUNS
;; ==========================================================================

;; --- Hauteur de chaque panneau et position de son bord haut (px) ---------
;; Calculees par mise-en-page.py, envoyees en UN seul "eww update" apres
;; chaque arrivee de donnees (voir publier.sh) et a chaque repli. y_mail et
;; y_veille servent a aligner la modale (ui.sh).
;; 0 = pas encore calcule (voir le widget panel ci-dessous).
;; t_* = panneau tronque : le script n'a pas pu lui donner toute la hauteur
;; qu'il demandait, sa liste continue sous le bord (degrade + chevron).
;; r_* = panneau replie. C'est AUSSI le script qui les pousse, dans le meme
;; "eww update" que les hauteurs : le chevron, le corps qui disparait et
;; la nouvelle hauteur changent dans le meme rendu. L'etat lui-meme vit
;; dans ~/.cache/pai/replies.json (il survit aux redemarrages) : r_* n'en
;; est que le reflet, repousse a chaque calcul. Ne jamais les modifier a
;; la main avec "eww update r_..." (les hauteurs ne suivraient pas, et le
;; calcul suivant l'effacerait) : passer par "mise-en-page.py --basculer".
(defvar h_reco 0)
(defvar h_venir 0)
(defvar h_mail 0)
(defvar h_veille 0)
(defvar y_reco 0)
(defvar y_venir 0)
(defvar y_mail 0)
(defvar y_veille 0)
(defvar t_reco false)
(defvar t_venir false)
(defvar t_mail false)
(defvar t_veille false)
(defvar r_reco false)
(defvar r_venir false)
(defvar r_mail false)
(defvar r_veille false)
;; seuil_corps = hauteur minimale (px) pour qu'un panneau ouvert affiche son
;; corps sans deborder (le plancher de mise-en-page.py, pousse par lui).
;; Sert pendant l'animation d'un depli : le panneau passe par des hauteurs
;; trop petites pour sa liste, qui n'apparait qu'une fois le seuil atteint.
;; 0 avant le premier calcul : rien n'est masque au demarrage.
(defvar seuil_corps 0)

;; --- Panneau principal : en-tete (chevron, titre, resume, bouton ↻), puis
;;     le corps (separateur + zone de defilement) ------------------------
;; Attention : eww refuse un (for ...) passe directement en enfant d'un
;; widget perso ("can only be used as a child of some container widget") --
;; toujours l'envelopper dans un (box ...) cote appelant.
;; source  = argument passe a sync.sh (digest | recos | venir | veille)
;; sync    = heure de la derniere synchro, affichee en infobulle du bouton ↻
;; resume  = texte court affiche a droite de l'en-tete ("8 à traiter"...),
;;           pre-calcule par le script fetch-*.sh (champ "resume" du JSON)
;; hauteur = hauteur TOTALE du panneau en px, bordures comprises (h_reco...)
;; tronque = t_reco... : affiche le chevron et le degrade de coupe.
;; panneau = nom du panneau pour mise-en-page.py (reco | venir | mail | veille)
;; replie  = r_reco... : en-tete seul, corps masque.
;;
;; Hauteurs : c'est mise-en-page.py qui les decide (repartition elastique),
;; eww ne fait que les appliquer avec :height. Le corps est un scroll : ce
;; qui ne tient pas dans la hauteur defile.
;; :vexpand {hauteur == 0} : filet de securite, seulement tant que les
;; hauteurs valent 0 (avant le premier calcul) -- GTK partage alors la
;; place a parts egales au lieu de tout tasser en haut. Une fois les
;; hauteurs calculees, un panneau ne doit PLUS s'etirer : quand tout est
;; replie, la place libre doit rester vide (fond d'ecran), pas regonfler
;; les en-tetes.
(defwidget panel [title sync source resume hauteur tronque panneau replie]
  (box :class "panel ${replie ? 'replie' : ''}" :orientation "v" :space-evenly false
       :vexpand {hauteur == 0} :height hauteur
    ;; En-tete : DEUX zones cote a cote, la zone cliquable et le bouton ↻.
    ;; Le bouton est volontairement HORS de l'eventbox : a l'interieur, un
    ;; clic sur ↻ remontait aussi jusqu'a l'eventbox et repliait le panneau
    ;; en plus de le synchroniser (constate a l'essai). Cote a cote, aucun
    ;; des deux ne contient l'autre : un clic ne peut en toucher qu'un.
    (box :class "header" :orientation "h" :space-evenly false
      ;; Zone CLIQUABLE (eventbox) : tout l'en-tete sauf ↻. Replie /
      ;; deplie le panneau. mise-en-page.py --basculer relit l'etat,
      ;; bascule CE panneau, recalcule toutes les hauteurs et pousse le tout
      ;; en un seul update.
      ;; setsid -f : commande DETACHEE d'eww, qui rend la main tout de suite.
      ;; eww TUE une commande onclick au bout de son timeout (200ms par
      ;; defaut), et sur une EVENTBOX, ":timeout" n'agit pas sur le clic
      ;; (eww 0.6.0 : cinq groupes de proprietes y declarent chacun leur
      ;; timeout, celui du clic en dernier -- constate le 11/09 : clics
      ;; tues a ~200ms malgre :timeout "5s"). Or --basculer prend 200 a
      ;; 300ms : il etait tue en plein travail (fichier d'etat change, mais
      ;; pas l'affichage). Detache, plus rien ne peut le couper. Deux clics
      ;; rapides restent dans l'ordre : le verrou du script les enchaine.
      (eventbox :class "entete-clic" :hexpand true :cursor "pointer"
                :tooltip {replie ? "déplier" : "replier (donne la place aux autres)"}
                :onclick "setsid -f python3 ~/.config/eww/mise-en-page.py --basculer ${panneau} > ~/.cache/eww/mise-en-page.log 2>&1"
        (box :orientation "h" :space-evenly false
          ;; Chevron de repli, a gauche du titre : ▾ ouvert, ▸ replie.
          (label :class "chevron" :text {replie ? "▸" : "▾"})
          (label :class "title" :halign "start" :hexpand true :text title)
          ;; Le compteur reste affiche une fois replie : on perd la liste,
          ;; jamais l'information qu'il y a quelque chose.
          (label :class "resume" :halign "end" :visible {resume != ''} :text resume)
          ;; Chevron de coupe, colle au compteur : "il y en a plus que ce
          ;; qui se voit". Le degrade en bas du corps dit OU ca continue.
          ;; Jamais sur un panneau replie (le script met alors t_* a false).
          (label :class "coupe" :visible tronque :text "▼"
                 :tooltip "la liste continue : faire défiler")))
      ;; L'heure de synchro passe en infobulle du bouton ↻ : l'afficher en
      ;; clair sur tous les en-tetes a la fois ne tient pas dans la largeur
      ;; de la colonne.
      ;; :timeout "15s" : eww TUE une commande onclick au bout de son
      ;; timeout, 200ms par defaut (verifie dans le source 0.6.0,
      ;; run_command -> child.kill()). sync.sh fait un curl vers n8n
      ;; (>= 0.45s, --max-time 8) : sans ce timeout, il etait tue avant
      ;; d'avoir mis a jour le panneau.
      ;; Il fixe aussi la hauteur de l'en-tete (29px), donc celle d'un
      ;; panneau replie (HAUTEUR_ENTETE) : ne pas le masquer au repli.
      (button :class "sync-icon" :timeout "15s" :tooltip "sync ${sync}"
              :onclick "bash ~/.config/eww/sync.sh ${source}" "↻"))
    ;; Corps : separateur + liste, masques quand le panneau est replie, ET
    ;; tant qu'il est plus petit que seuil_corps : pendant l'animation d'un
    ;; depli, la liste attend d'avoir la place (sinon elle deborderait et
    ;; pousserait le bandeau). Au repli, elle disparait des la 1re image.
    (box :class "sep" :visible {!replie && hauteur >= seuil_corps})
    ;; overlay : le 1er enfant (le scroll) donne la taille, les suivants
    ;; sont poses PAR-DESSUS. Le scroll (vertical seulement) absorbe le
    ;; contenu qui depasse ; les labels non wrappes ont :truncate true pour
    ;; ne pas elargir la fenetre.
    (overlay :vexpand true :visible {!replie && hauteur >= seuil_corps}
      (scroll :class "sections" :vscroll true :hscroll false :vexpand true
        (box :orientation "v" :space-evenly false
          (children)))
      ;; Degrade de coupe, cale en bas (:valign "end"). C'est un simple box :
      ;; sans fenetre GDK a lui, il laisse passer la molette jusqu'au scroll
      ;; en dessous. Limite : eww ne connait pas la position de defilement,
      ;; le degrade reste donc visible meme une fois arrive en bas.
      ;; 20px : environ une ligne. Plus haut, il griserait toute la zone
      ;; visible d'un panneau reduit a son plancher (une seule ligne).
      (box :class "coupe-degrade" :valign "end" :height 20 :visible tronque))))


;; ==========================================================================
;;  RECOMMANDATIONS DU JOUR  (auto-refresh 20 min)
;; ==========================================================================
(defpoll recos :interval "20m" :initial "{\"recommandations\":[]}"
  "bash ~/.config/eww/fetch-recos.sh")

(defwidget reco_card [reco]
  (box :class "reco-card" :orientation "v" :space-evenly false
    (box :class "reco-head" :orientation "h" :space-evenly false
      (label :class "reco-dot ${reco.priorite ?: 'basse'}" :text "●")
      (label :class "reco-title" :halign "start" :hexpand true :wrap true
             :text {reco.titre ?: '(sans titre)'}))
    (label :class "reco-detail" :halign "start" :wrap true
           :visible {(reco.detail ?: '') != ''}
           :text {reco.detail ?: ''})))

(defwidget recos_box []
  (panel :title "RECOMMANDATIONS" :sync {recos.sync ?: '--:--'} :source "recos"
         :resume {recos.resume ?: ''} :hauteur h_reco :tronque t_reco
         :panneau "reco" :replie r_reco
    (label :class "reco-empty" :halign "start" :wrap true
           :visible {arraylength(recos.recommandations ?: []) == 0}
           :text "Aucune recommandation pour le moment.")
    (box :orientation "v" :space-evenly false
      (for reco in {recos.recommandations ?: []}
        (reco_card :reco reco)))))


;; ==========================================================================
;;  A VENIR  (evenements agenda + taches datees ; auto-refresh 10 min)
;; ==========================================================================
;; La liste arrive DEJA fusionnee, triee, groupee et resumee par n8n : voir
;; fetch-venir.sh pour le contrat de donnees. eww ne fait qu'afficher : un
;; groupe = un titre + ses lignes, le glyphe distingue les deux sources.
;; Pas de detail au clic.
(defpoll venir :interval "10m" :initial "{\"groupes\":[]}"
  "bash ~/.config/eww/fetch-venir.sh")

;; --- Ligne : glyphe (▪ evenement, ☐ tache), titre tronque, echeance a
;;     droite. cle = cle du groupe ("retard"...) : sert de classe CSS, pour
;;     colorer l'echeance des elements en retard. Les champs type / titre /
;;     quand existent toujours (completes par fetch-venir.sh).
(defwidget venir_item [it cle]
  (box :class "venir-item" :orientation "h" :space-evenly false
    (label :class "venir-glyphe" :text {it.type == "event" ? "▪" : "☐"})
    (label :class "venir-titre" :halign "start" :hexpand true :truncate true
           :text {it.titre})
    (label :class "venir-quand ${cle}" :halign "end" :visible {it.quand != ""}
           :text {it.quand})))

;; --- Groupe : titre ("► EN RETARD · 1"), puis ses lignes. Les groupes vides
;;     sont retires par fetch-venir.sh : jamais de titre orphelin ici.
(defwidget venir_groupe [g]
  (box :class "section" :orientation "v" :space-evenly false
    (label :class "sect-label venir-${g.cle}" :halign "start" :text "► ${g.entete}")
    (for it in {g.items}
      (venir_item :it it :cle {g.cle}))))

(defwidget venir_box []
  (panel :title "À VENIR" :sync {venir.synchro ?: '--:--'} :source "venir"
         :resume {venir.resume ?: ''} :hauteur h_venir :tronque t_venir
         :panneau "venir" :replie r_venir
    (label :class "venir-vide" :halign "start" :wrap true
           :visible {arraylength(venir.groupes ?: []) == 0}
           :text "Rien à venir.")
    (box :orientation "v" :space-evenly false
      (for g in {venir.groupes ?: []}
        (venir_groupe :g g)))))


;; ==========================================================================
;;  BOITE DE RECEPTION  (auto-refresh 5 min)
;; ==========================================================================
;; :initial inclut "by_id":{} : sans ca, digest.by_id vaut null tant que
;; fetch-digest.sh n'a pas rendu son premier resultat, et indexer [id]
;; dessus plante le rendu du widget entier ("Unable to index into value
;; null" dans eww-daemon.out.log) -- constate en prod le 12/08. by_id est
;; lu par la modale (modale_box, plus bas).
(defpoll digest :interval "5m" :initial "{\"by_id\":{}}"
  "bash ~/.config/eww/fetch-digest.sh")

;; --- Mail affiche dans la modale : son mail_id, "" = aucun. Ecrit par
;;     ui.sh (open / close). Sert aussi a marquer la ligne choisie.
(defvar mail_modale "")

;; --- Ligne de mail : clic -> modale de CE mail, et rien d'autre (les
;;     actions sont les boutons de la modale). La ligne reste marquee
;;     (classe selected) tant que sa modale est ouverte.
;; setsid -f : ui.sh enchaine plusieurs appels eww (~100ms), et eww TUE
;; une commande onclick au bout de 200ms -- sur une eventbox, ":timeout" ne
;; change rien (voir l'en-tete du widget panel). Tuee entre son "eww
;; update" et son "eww open", la ligne serait marquee sans modale.
;; Detachee, elle va toujours au bout.
;; Deux classes, deux widgets : l'eventbox porte "item" (fond au survol,
;; selection) mais IGNORE le padding CSS (GTK3, mesure le 11/09 : lignes
;; de 33px au lieu de 37) ; le padding va donc sur la box interieure
;; ("item-corps"), sinon mise-en-page.py compterait 4px de trop par mail.
(defwidget mail_item [it]
  (eventbox :class "item ${it.mail_id == mail_modale ? 'selected' : ''}"
            :onclick "setsid -f bash ~/.config/eww/ui.sh open mail '${it.mail_id}' >/dev/null 2>&1"
    (box :class "item-corps" :orientation "v" :space-evenly false :hexpand true
      (label :class "item-subject ${it.read ? '' : 'nonlu'}"
             :halign "start" :hexpand true :wrap false :truncate true
             :text "  ${it.urgent ? '⚠ ' : ''}${it.read ? '' : '● '}${it.subject_short}")
      (label :class "item-meta" :halign "start" :truncate true :visible {it.meta != ''}
             :text "      ${it.meta}"))))

(defwidget section [label items]
  (box :class "section" :orientation "v" :space-evenly false
    (label :class "sect-label" :halign "start" :text "► ${label}")
    (for it in {items ?: []}
      (mail_item :it it))))

(defwidget digest_box []
  (panel :title "BOÎTE DE RÉCEPTION" :sync {digest.sync ?: '--:--'} :source "digest"
         :resume {digest.resume ?: ''} :hauteur h_mail :tronque t_mail
         :panneau "mail" :replie r_mail
    (label :class "mail-vide" :halign "start" :wrap true
           :visible {arraylength(digest.sections ?: []) == 0}
           :text "Aucun mail.")
    (box :orientation "v" :space-evenly false
      (for s in {digest.sections ?: []}
        (section :label {s.label} :items {s.items})))))


;; ==========================================================================
;;  VEILLE  ("qu'est-ce qui bouge dans mon domaine ?" ; auto-refresh 30 min)
;; ==========================================================================
;; La selection, l'ordre et la phrase "pourquoi c'est pour toi" sont faits
;; par n8n : voir fetch-veille.sh pour le contrat de donnees. Le panneau ne
;; fait qu'afficher. 30 min : la veille bouge lentement, inutile d'appeler
;; n8n aussi souvent que pour les mails.
;; :initial inclut "by_id":{} : meme raison que pour digest (la modale
;; indexe by_id[...] avant le premier fetch).
(defpoll veille :interval "30m" :initial "{\"items\":[],\"by_id\":{}}"
  "bash ~/.config/eww/fetch-veille.sh")

;; --- Item de veille affiche dans la modale : son id, "" = aucun. Ecrit
;;     par ui.sh ; sert aussi a marquer la ligne choisie. Jamais rempli en
;;     meme temps que mail_modale (ui.sh vide l'un quand il remplit l'autre).
(defvar veille_modale "")

;; --- Ligne de veille : UN seul niveau, titre a gauche (coupe par une
;;     ellipse s'il est trop long), "source · age" a droite. 22px, comme
;;     une ligne d'A VENIR (ligne_veille dans mise-en-page.py).
;; Meme traitement que les mails, SANS couleur propre : meme pastille "●"
;; et meme gras pour ce qui est neuf, meme fond au survol et a la selection
;; (classes item, item-corps, item-subject, nonlu), meme modale. Ce qui
;; distingue les deux panneaux, c'est leur en-tete et leur contenu, pas une
;; couleur : la couleur reste reservee au sens (urgent, retard).
;; La phrase "pourquoi" n'est PAS ici : elle vit dans la modale.
;; eventbox + box interieure, setsid -f : memes raisons que mail_item.
(defwidget veille_item [it]
  (eventbox :class "item ${it.id == veille_modale ? 'selected' : ''}"
            :onclick "setsid -f bash ~/.config/eww/ui.sh open veille '${it.id}' >/dev/null 2>&1"
    (box :class "item-corps" :orientation "h" :space-evenly false :hexpand true
      (label :class "item-subject ${it.neuf ? 'nonlu' : ''}"
             :halign "start" :hexpand true :truncate true
             :text "  ${it.neuf ? '● ' : ''}${it.titre}")
      (label :class "veille-meta" :halign "end" :visible {it.meta != ''}
             :text {it.meta}))))

(defwidget veille_box []
  (panel :title "VEILLE" :sync {veille.synchro ?: '--:--'} :source "veille"
         :resume {veille.resume ?: ''} :hauteur h_veille :tronque t_veille
         :panneau "veille" :replie r_veille
    (label :class "veille-vide" :halign "start" :wrap true
           :visible {arraylength(veille.items ?: []) == 0}
           :text "Rien de neuf.")
    (box :orientation "v" :space-evenly false
      (for it in {veille.items ?: []}
        (veille_item :it it)))))


;; ==========================================================================
;;  MODALE  (clic sur une ligne de mail ou de veille)
;; ==========================================================================
;; UN seul widget, modale_contenu, parametre par la source : le titre, les
;; lignes du corps et les boutons changent, la forme reste la meme. Il est
;; repris de la modale d'avant l'accordeon (commit 8c5b890 : side_panel +
;; detail_content) ; le corps defile (scroll), la modale ayant une hauteur
;; fixe, et les boutons restent en bas. modale_mail et modale_veille ne
;; font que remplir ses parametres.

;; --- Separateur + resume (masques si le texte est vide) ----------------
(defwidget side_summary [text]
  (box :orientation "v" :space-evenly false :visible {text != ''}
    (box :class "side-sep")
    (label :class "side-summary" :halign "start" :wrap true :xalign 0 :text text)))

;; --- Bouton d'action de la modale --------------------------------------
;; commande = ligne shell lancee au clic ; "" = bouton inerte (:active
;; false), en pointilles. L'infobulle "emplacement libre" n'apparait que sur
;; les vrais emplacements "à définir" : un "Ouvrir la source" inerte (item
;; sans lien) n'est pas un emplacement a definir.
;; setsid -f : la commande est detachee d'eww. Sinon eww la TUE a la fin de
;; son :timeout (200ms par defaut, voir le bouton ↻) -- et un navigateur
;; que xdg-open venait de lancer pouvait etre tue avec elle.
(defwidget action [libelle commande]
  (button :class "action-btn ${commande == '' ? 'a-definir' : ''}"
          :active {commande != ''}
          :tooltip {libelle == 'à définir' ? 'Emplacement libre : action à définir (eww.yuck, modale_mail / modale_veille)' : ''}
          :onclick "setsid -f ${commande} >/dev/null 2>&1"
          libelle))

;; L'item est passe deja resolu, avec un repli "{}" a CHAQUE niveau
;; d'indexation : by_id peut etre null avant le premier fetch, et
;; by_id[id] l'est si l'id est absent (item disparu au dernier
;; rafraichissement). Indexer un champ sur null plante le rendu du widget
;; entier (constate le 12/08). Un seul des deux contenus est visible :
;; ui.sh ne remplit jamais mail_modale et veille_modale en meme temps.
(defwidget modale_box []
  (box :orientation "v" :vexpand true :visible {mail_modale != '' || veille_modale != ''}
    (box :orientation "v" :vexpand true :visible {mail_modale != ''}
      (modale_mail :mail {(digest.by_id ?: {})[mail_modale] ?: {}}))
    (box :orientation "v" :vexpand true :visible {veille_modale != ''}
      (modale_veille :it {(veille.by_id ?: {})[veille_modale] ?: {}}))))

;; titre   = en-tete de la modale (a cote de la croix ✕)
;; ligne1  = premiere ligne du corps, en petit gris ("" = masquee)
;; ligne2  = deuxieme ligne, plus petite encore ("" = masquee)
;; texte   = paragraphe principal ("" = masque)
;; resume  = paragraphe sous un separateur ("" = masque)
;; l1..l4 / c1..c4 = libelle et commande des quatre boutons (voir action)
(defwidget modale_contenu [titre ligne1 ligne2 texte resume l1 c1 l2 c2 l3 c3 l4 c4]
  (box :class "panel side" :orientation "v" :space-evenly false :hexpand true :vexpand true
    ;; En-tete : titre + croix de fermeture
    (box :class "detail-head" :orientation "h" :space-evenly false
      (label :class "side-title" :halign "start" :hexpand true :wrap true :xalign 0
             :valign "start" :text titre)
      (button :class "close-btn" :valign "start" :timeout "5s"
              :onclick "bash ~/.config/eww/ui.sh close" "✕"))
    ;; Corps : defile si le texte est long
    (scroll :vscroll true :hscroll false :vexpand true
      (box :orientation "v" :space-evenly false
        (label :class "side-from" :halign "start" :wrap true :xalign 0
               :visible {ligne1 != ''} :text ligne1)
        (label :class "side-badges" :halign "start"
               :visible {ligne2 != ''} :text ligne2)
        (label :class "side-reason" :halign "start" :wrap true :xalign 0
               :visible {texte != ''} :text texte)
        (side_summary :text resume)))
    ;; Actions, toujours visibles en bas. Ce sont ELLES qui agissent sur
    ;; l'item (le clic sur la ligne ne fait qu'ouvrir la modale).
    (box :class "detail-actions" :orientation "h" :space-evenly true
      (action :libelle l1 :commande c1)
      (action :libelle l2 :commande c2)
      (action :libelle l3 :commande c3)
      (action :libelle l4 :commande c4))))

;; --- Contenu MAIL. Bouton 1 : Gmail web plutot que Thunderbird (choix du
;; 11/09) : le JSON ne donne que l'id Gmail, Thunderbird n'aurait pu que
;; s'ouvrir, sans afficher CE mail.
;; TODO : trois emplacements libres (en attente de Gauthier). Pour en
;; cabler un : remplacer le libelle et mettre la commande shell (les champs
;; du mail sont dans mail.*, ex. ${mail.mail_id}).
(defwidget modale_mail [mail]
  (modale_contenu
    :titre {mail.subject ?: '(mail introuvable)'}
    :ligne1 "${mail.from ?: ''}  <${mail.email ?: ''}>"
    :ligne2 "${mail.category ?: ''} · ${mail.intent ?: ''} · ${(mail.read ?: false) ? 'lu' : 'non lu'}"
    :texte {mail.reason ?: ''}
    :resume {mail.summary ?: ''}
    :l1 "Ouvrir email" :c1 "xdg-open '${mail.url ?: ''}'"
    :l2 "à définir" :c2 ""
    :l3 "à définir" :c3 ""
    :l4 "à définir" :c4 ""))

;; --- Contenu VEILLE : le titre de l'article, "source · age", puis la
;; phrase de curation ("pourquoi c'est pour toi"), qui ne s'affiche QUE ici.
;; Bouton 1 : ouvre l'article dans le navigateur (xdg-open, comme le mail).
;; L'url passe entre apostrophes dans une commande shell : c'est sans
;; danger parce que fetch-veille.sh ne laisse passer que des liens
;; http(s), sans espace, apostrophe codee %27 (voir url_sure). Item sans
;; url (absente ou refusee) : commande vide -> bouton inerte, rien n'est
;; lance.
;; TODO : emplacements 2 a 4, en attente de Gauthier. Ne rien inventer.
(defwidget modale_veille [it]
  (modale_contenu
    :titre {it.titre ?: '(article introuvable)'}
    :ligne1 {it.meta ?: ''}
    :ligne2 ""
    :texte {it.pourquoi ?: ''}
    :resume ""
    :l1 "Ouvrir la source"
    :c1 {(it.url ?: '') != '' ? "xdg-open '${it.url}'" : ''}
    :l2 "à définir" :c2 ""
    :l3 "à définir" :c3 ""
    :l4 "à définir" :c4 ""))


;; ==========================================================================
;;  BANDEAU  (bas de la colonne : une ligne fixe)
;; ==========================================================================
;; Tout est calcule en local, sans n8n :
;;  - horloge : 10 s suffisent, l'heure n'affiche que les minutes.
;;  - vrac    : taches Taskwarrior sans date (voir fetch-vrac.sh). 1 min.
;;  - sys     : CPU / RAM / reseau en % (voir fetch-sys.sh, et pourquoi pas
;;              les variables magiques EWW_CPU & co). 5 s.
(defpoll horloge :interval "10s" :initial ""
  "LC_TIME=fr_FR.UTF-8 date '+%a %-d %b · %H:%M'")

(defpoll vrac :interval "1m" :initial "{\"texte\":\"\"}"
  "bash ~/.config/eww/fetch-vrac.sh")

(defpoll sys :interval "5s" :initial "{\"cpu\":0,\"ram\":0,\"net\":0}"
  "bash ~/.config/eww/fetch-sys.sh")

;; --- Jauge : nom + barre (widget progress, valeur 0-100) -------------------
;; Le style des barres (fond + remplissage) est dans eww.scss : sans lui,
;; "* { all: unset; }" les rendrait invisibles.
(defwidget jauge [nom valeur]
  (box :class "jauge" :orientation "h" :space-evenly false :spacing 6
    (label :class "jauge-nom" :text nom)
    (progress :class "barre" :valign "center" :orientation "h" :value valeur)))

(defwidget bandeau []
  (box :class "bandeau" :orientation "h" :space-evenly false
    (label :class "horloge" :text horloge)
    (label :class "bandeau-sep" :visible {(vrac.texte ?: '') != ''} :text "│")
    (label :class "vrac" :visible {(vrac.texte ?: '') != ''} :text {vrac.texte ?: ''})
    ;; boite vide extensible : pousse les jauges contre le bord droit
    (box :hexpand true)
    (jauge :nom "CPU" :valeur {sys.cpu ?: 0})
    (jauge :nom "RAM" :valeur {sys.ram ?: 0})
    (jauge :nom "NET" :valeur {sys.net ?: 0})))


;; ==========================================================================
;;  FENETRES  (ecran 0 par defaut, --screen impose par start.sh)
;; ==========================================================================

;; --- La colonne : UNE seule fenetre pour tous les panneaux (refonte 09/2026)
;; Pourquoi une seule fenetre : avant, chaque panneau avait la sienne, et
;; tout changement de taille obligeait a recalculer a la main la geometrie
;; des autres. Ici les panneaux sont empiles dans une vbox, a l'interieur
;; d'une fenetre de hauteur FIXE (c'est ce qui colle le bandeau en bas).
;;
;; Geometrie : meme marge en haut et en bas de l'ecran (symetrie). Il
;; faudrait donc une hauteur "100% - 2 x marge", mais eww 0.6.0 refuse de
;; melanger les unites dans une meme valeur ("96%-24px" -> "Invalid unit",
;; teste le 10/09), et un % ne tombe juste que sur un seul ecran. D'ou des
;; ARGUMENTS de fenetre, calcules et passes par ouvrir-colonne.sh a
;; l'ouverture (eww open colonne --arg marge=20px --arg hauteur=1040px
;; --arg droite=-48px) :
;;   marge   = ecart bord de l'ecran <-> haut de la colonne (et bas du bandeau)
;;   hauteur = hauteur de l'ecran cible (lue par xrandr) - 2 x marge
;;   droite  = ecart au bord droit, NEGATIF (anchor right : x negatif = vers
;;             la gauche depuis le bord droit), pour le panneau LXQt
;; Reglages : geometrie.conf (MARGE, MARGE_DROITE), nulle part ailleurs.
;;
;; Pourquoi des arguments et pas une variable (defvar marge_droite) : eww
;; 0.6.0 refuse une variable globale dans :geometry ("Unknown variable",
;; teste le 11/09) et fige la position a l'ouverture. Changer la marge =
;; rouvrir la fenetre : c'est ce que fait marge.sh, sans redemarrer eww.
;;
;; Picom floute TOUTE la surface d'une fenetre Eww (voir picom.conf) : les
;; 16px d'ecart entre panneaux (:spacing) apparaissent donc floutes, sans
;; le voile blanc ni la bordure des panneaux.
;;
;; !! L'ecart (:spacing 16, sur les DEUX box ci-dessous) et la largeur
;; (:width "33%") sont DOUBLES dans mise-en-page.py (ECART, LARGEUR_PCT) :
;; a modifier aux deux endroits.
(defwindow colonne [marge hauteur droite]
  :monitor 0
  :geometry (geometry :x droite :y marge :width "33%" :height hauteur :anchor "top right")
  :stacking "bg" :windowtype "dock" :wm-ignore false
  ;; Deux niveaux de box, pour le repli :
  ;;  - "panneaux" (:vexpand true) prend toute la hauteur au-dessus du
  ;;    bandeau. Ses panneaux ont les hauteurs de mise-en-page.py, qui la
  ;;    remplissent exactement... sauf quand TOUT est replie : les en-tetes
  ;;    restent alors empiles en haut, et le vide en dessous laisse voir le
  ;;    fond d'ecran (mode bureau calme).
  ;;  - le bandeau, dernier enfant de "colonne", reste donc colle en bas
  ;;    dans tous les cas.
  ;; Ecarts : 3 entre les quatre panneaux + 1 entre "panneaux" et le
  ;; bandeau = 4 = n x ECART dans mise-en-page.py.
  (box :class "colonne" :orientation "v" :space-evenly false :spacing 16
    ;; Ordre = un degrade d'urgence : qu'est-ce que je fais maintenant ->
    ;; qu'est-ce qui est engage -> qu'est-ce qui demande une reponse ->
    ;; qu'est-ce qui bouge dans mon domaine. La veille, seule chose sans
    ;; echeance, vient en dernier : elle ne s'intercale pas dans ce qui en a.
    (box :class "panneaux" :orientation "v" :space-evenly false :spacing 16 :vexpand true
      (recos_box)
      (venir_box)
      (digest_box)
      (veille_box))
    (bandeau)))

;; --- Modale : fenetre SEPAREE, meme couche que la colonne (bg/dock : les
;; clics y fonctionnent, seul le focus clavier manque -- inutile ici).
;; Ouverte/fermee REELLEMENT par ui.sh, jamais mappee en permanence : une
;; fenetre transparente laissee mappee laisse un fond fantome sous picom
;; (constate le 12/08). Geometrie : ARGUMENTS calcules par ui.sh au clic
;; (eww refuse une variable dans :geometry) :
;;   x       = -(marge droite + largeur colonne + 14) : juste a gauche
;;   y       = haut du panneau d'ou vient l'item (y_mail ou y_veille) AU
;;             MOMENT DU CLIC, recale vers le haut si la modale depasserait
;;             le bas de l'ecran (toujours le cas pour la veille, en bas)
;;   hauteur = 420px, propre a la modale
;; Un argument est fige a l'ouverture : si les panneaux changent de hauteur
;; pendant que la modale est ouverte, elle ne bouge pas. Exception : replier
;; ou deplier N'IMPORTE QUEL panneau la FERME (mise-en-page.py,
;; fermer_modale) : les panneaux bougent, elle ne serait plus alignee.
(defwindow modale [x y hauteur]
  :monitor 0
  :geometry (geometry :x x :y y :width "30%" :height hauteur :anchor "top right")
  :stacking "bg" :windowtype "dock" :wm-ignore false
  (modale_box))
