;; ~/.config/eww/eww.yuck - Viridis Lab : digest mail + agenda (clic = detail)
;;                                       + recommandations (verre)
;; Demarrage :  voir start.sh (ouvre toutes les fenetres sur le bon ecran)
;; Recharger :  eww reload
;;
;; NOTE (12/08) : le survol (apercu au hover) a ete entierement retire.
;; Il causait des bugs recurrents et jamais totalement resolus (fenetres qui
;; restent ouvertes, qui ne s'affichent pas, fond glassmorphique fantome
;; visible en permanence...) malgre plusieurs refontes successives. Seul le
;; clic (ouverture d'un detail complet, fermable) est conserve : il s'est
;; montre fiable tout du long. Le survol sera rebati plus tard, proprement,
;; sur cette base saine.
;;
;; Noms a ne pas renommer sans mettre a jour les scripts :
;;   - variables opened_id / ev_opened_id   -> ui.sh
;;   - fenetres recos digest events detail ev_detail -> start.sh, ui.sh,
;;     eww-watchdog.sh


;; ==========================================================================
;;  WIDGETS COMMUNS
;; ==========================================================================

;; --- Panneau principal : en-tete (titre, heure de synchro, bouton ↻),
;;     separateur, puis le contenu (children) ------------------------------
;; Attention : eww refuse un (for ...) passe directement en enfant d'un
;; widget perso ("can only be used as a child of some container widget") --
;; toujours l'envelopper dans un (box ...) cote appelant.
;; source = argument passe a sync.sh (digest | recos | events)
(defwidget panel [title sync source]
  (box :class "panel" :orientation "v" :space-evenly false
    (box :class "header" :orientation "h" :space-evenly false
      (label :class "title" :halign "start" :hexpand true :text title)
      (label :class "synced" :halign "end" :text "Synchronisation - ${sync}")
      (button :class "sync-icon" :onclick "bash ~/.config/eww/sync.sh ${source}" "↻"))
    (box :class "sep")
    ;; Taille FIXE : la geometry de la fenetre n'est qu'un minimum pour GTK,
    ;; qui agrandit la fenetre si le contenu deborde. Le scroll (vertical
    ;; seulement) absorbe le surplus en hauteur ; les labels non wrappes
    ;; ont :truncate true pour ne pas elargir la fenetre.
    (scroll :class "sections" :vscroll true :hscroll false :vexpand true
      (box :orientation "v" :space-evenly false
        (children)))))

;; --- Panneau lateral de detail : titre + bouton ✕, puis le contenu -------
(defwidget side_panel [title onclose]
  (box :class "panel side" :orientation "v" :space-evenly false
    (box :class "detail-head" :orientation "h" :space-evenly false
      (label :class "side-title" :halign "start" :hexpand true :wrap true :valign "start"
             :text title)
      (button :class "close-btn" :valign "start" :onclick onclose "✕"))
    (children)))

;; --- Separateur + texte long du detail (masques si le texte est vide) ----
(defwidget side_summary [text]
  (box :orientation "v" :space-evenly false :visible {text != ''}
    (box :class "side-sep")
    (label :class "side-summary" :halign "start" :wrap true :text text)))

;; --- Barre d'actions, poussee tout en bas du panneau lateral -------------
(defwidget action_bar []
  (box :orientation "v" :space-evenly false :vexpand true :valign "end"
    (box :class "detail-actions" :orientation "h" :space-evenly true
      (children))))


;; ==========================================================================
;;  DIGEST MAIL  (clic = detail ; auto-refresh 5 min)
;; ==========================================================================
(defvar opened_id "")

;; :initial inclut "by_id":{} : sans ca, digest.by_id vaut null tant que
;; fetch-digest.sh n'a pas rendu son premier resultat, et indexer [id]
;; dessus plante le rendu du widget entier ("Unable to index into value
;; null" dans eww-daemon.out.log) -- constate en prod le 12/08.
(defpoll digest :interval "5m" :initial "{\"by_id\":{}}"
  "bash ~/.config/eww/fetch-digest.sh")

;; --- Item : clic -> detail ; highlight persistant sur le mail ouvert -----
(defwidget mail_item [it]
  (eventbox :class "item ${it.mail_id == opened_id ? 'selected' : ''}"
            :onclick "bash ~/.config/eww/ui.sh open '${it.mail_id}'"
    (box :orientation "v" :space-evenly false :hexpand true
      (label :class "item-subject ${it.read ? '' : 'nonlu'}"
             :halign "start" :hexpand true :wrap false :truncate true
             :text "  ${it.urgent ? '⚠ ' : ''}${it.read ? '' : '● '}${it.subject_short}")
      (label :class "item-meta" :halign "start" :truncate true :visible {it.meta != ''}
             :text "      ${it.meta}"))))

(defwidget section [label items]
  (box :class "section" :orientation "v" :space-evenly false
    (label :class "sect-label" :halign "start" :text "► ${label}")
    (for it in {items ?: []}
      (mail_item :it it))))

(defwidget digest_box []
  (panel :title "BOÎTE DE RÉCEPTION" :sync {digest.sync ?: '--:--'} :source "digest"
    (box :orientation "v" :space-evenly false
      (for s in {digest.sections ?: []}
        (section :label {s.label} :items {s.items})))))

;; --- Detail (clic, fermable) -----------------------------------------------
;; Fenetre ouverte/fermee reellement (eww open/close) par ui.sh au moment du
;; clic -- PAS mappee en permanence (constate le 12/08 : une fenetre
;; transparente mappee en continu, meme contenu masque via :visible, laisse
;; un fond fantome visible au repos sous ce compositeur). Le :visible
;; ci-dessous reste une securite supplementaire (contenu nul tant que
;; opened_id est vide), mais c'est bien l'open/close reel qui evite le fond
;; fantome. digest.by_id[opened_id] passe par un repli "{}" a CHAQUE niveau
;; d'indexation (digest.by_id lui meme peut etre null avant le premier
;; fetch, et digest.by_id[opened_id] peut l'etre aussi si l'id est absent)
;; avant tout acces a un champ, dans un sous-widget dedie -- sinon le rendu
;; entier plante.
(defwidget detail_box []
  (box :visible {opened_id != ''}
    (detail_content :mail {(digest.by_id ?: {})[opened_id] ?: {}})))

(defwidget detail_content [mail]
  (side_panel :title {mail.subject ?: ''} :onclose "bash ~/.config/eww/ui.sh close"
    (label :class "side-from" :halign "start" :wrap true
           :text "${mail.from ?: ''}  <${mail.email ?: ''}>")
    (label :class "side-badges" :halign "start"
           :text "${mail.category ?: ''} · ${mail.intent ?: ''} · ${(mail.read ?: false) ? 'lu' : 'non lu'}")
    (label :class "side-reason" :halign "start" :wrap true
           :text {mail.reason ?: ''})
    (side_summary :text {mail.summary ?: ''})
    ;; 3 derniers = placeholders a cabler plus tard
    (action_bar
      (button :class "action-btn" :onclick "xdg-open '${mail.url ?: ''}'" "Ouvrir email")
      (button :class "action-btn" "Action 2")
      (button :class "action-btn" "Action 3")
      (button :class "action-btn" "Action 4"))))


;; ==========================================================================
;;  RECOMMANDATIONS DU JOUR  (auto-refresh 20 min)
;; ==========================================================================
(defpoll recos :interval "20m" :initial "{}"
  "bash ~/.config/eww/fetch-recos.sh")

(defwidget reco_card [reco]
  (box :class "reco-card" :orientation "v" :space-evenly false
    (box :class "reco-head" :orientation "h" :space-evenly false
      (label :class "reco-dot ${reco.priorite ?: 'basse'}" :text "●")
      (label :class "reco-title" :halign "start" :hexpand true :wrap true
             :text {reco.titre ?: '(sans titre)'}))
    (label :class "reco-detail" :halign "start" :wrap true
           :visible {(reco.detail ?: '') != ''}
           :text {reco.detail ?: ''})))

(defwidget recos_box []
  (panel :title "RECOMMANDATIONS DU JOUR" :sync {recos.sync ?: '--:--'} :source "recos"
    (label :class "reco-empty" :halign "start" :wrap true
           :visible {arraylength(recos.recommandations ?: []) == 0}
           :text "Aucune recommandation pour le moment.")
    (box :orientation "v" :space-evenly false
      (for reco in {recos.recommandations ?: []}
        (reco_card :reco reco)))))


;; ==========================================================================
;;  AGENDA  (clic = detail ; auto-refresh 10 min)
;; ==========================================================================
(defvar ev_opened_id "")

;; :initial inclut "by_id":{} pour la meme raison que digest ci-dessus.
(defpoll events :interval "10m" :initial "{\"by_id\":{}}"
  "bash ~/.config/eww/fetch-events.sh")

;; --- Ligne : nom a gauche (tronque), date/heure a droite ;
;;     clic -> detail ; highlight persistant sur l'evenement ouvert --------
(defwidget event_line [ev]
  (eventbox :class "ev-line ${ev.id == ev_opened_id ? 'selected' : ''}"
            :onclick "bash ~/.config/eww/ui.sh ev_open '${ev.id}'"
    (box :orientation "h" :space-evenly false :hexpand true
      (label :class "ev-name" :halign "start" :hexpand true :wrap false :truncate true
             :text {ev.name_short ?: '(sans titre)'})
      (label :class "ev-when" :halign "end" :wrap false
             :text {ev.when ?: ''}))))

(defwidget events_box []
  (panel :title "AGENDA" :sync {events.sync ?: '--:--'} :source "events"
    (label :class "ev-empty" :halign "start" :wrap true
           :visible {arraylength(events.events ?: []) == 0}
           :text "Aucun évènement à venir.")
    (box :orientation "v" :space-evenly false
      (for ev in {events.events ?: []}
        (event_line :ev ev)))))

;; --- Detail (clic, fermable) -----------------------------------------------
;; Meme architecture (open/close reel par ui.sh) que detail_box, voir son
;; commentaire, pilotee par ev_opened_id.
(defwidget ev_detail_box []
  (box :visible {ev_opened_id != ''}
    (ev_detail_content :ev {(events.by_id ?: {})[ev_opened_id] ?: {}})))

(defwidget ev_detail_content [ev]
  (side_panel :title {ev.name ?: ''} :onclose "bash ~/.config/eww/ui.sh ev_close"
    (label :class "side-from" :halign "start" :wrap true
           :text {ev.range ?: ''})
    (label :class "side-badges" :halign "start" :wrap true
           :text "${ev.calendar ?: ''} · ${ev.status ?: ''}${(ev.allday ?: false) ? ' · journée entière' : ''}")
    (label :class "ev-field" :halign "start" :wrap true
           :visible {(ev.location ?: '') != ''}
           :text "⚲ ${ev.location ?: ''}")
    (label :class "ev-field ev-link" :halign "start" :wrap true
           :visible {(ev.meet ?: '') != ''}
           :text "▷ Visioconférence disponible")
    (side_summary :text {ev.description ?: ''})
    ;; 2 derniers = placeholders a cabler plus tard
    (action_bar
      (button :class "action-btn" :onclick "xdg-open '${ev.url ?: ''}'" "Ouvrir l'agenda")
      (button :class "action-btn" :visible {(ev.meet ?: '') != ''}
              :onclick "xdg-open '${ev.meet ?: ''}'" "Rejoindre")
      (button :class "action-btn" "Action 3")
      (button :class "action-btn" "Action 4"))))


;; ==========================================================================
;;  FENETRES  (toutes : ecran 0 par defaut, --screen impose par start.sh/ui.sh)
;; ==========================================================================
(defwindow recos
  :monitor 0
  :geometry (geometry :x "-24px" :y "24px" :width "42%" :height "33%" :anchor "top right")
  :stacking "bg" :windowtype "dock" :wm-ignore false
  (recos_box))

(defwindow digest
  :monitor 0
  :geometry (geometry :x "-24px" :y "38%" :width "30%" :height "33%" :anchor "top right")
  :stacking "bg" :windowtype "dock" :wm-ignore false
  (digest_box))

(defwindow detail
  :monitor 0
  :geometry (geometry :x "-33%" :y "38%" :width "30%" :height "33%" :anchor "top right")
  :stacking "bg" :windowtype "dock" :wm-ignore false
  (detail_box))

(defwindow events
  :monitor 0
  :geometry (geometry :x "-24px" :y "74%" :width "25%" :height "22%" :anchor "top right")
  :stacking "bg" :windowtype "dock" :wm-ignore false
  (events_box))

(defwindow ev_detail
  :monitor 0
  :geometry (geometry :x "-28%" :y "56%" :width "28%" :height "40%" :anchor "top right")
  :stacking "bg" :windowtype "dock" :wm-ignore false
  (ev_detail_box))
